# Copie para .env.homolog e troque todos os CHANGE_ME. Gere APP_KEY por ambiente.
APP_NAME="Cursos API - Homologação"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://homolog.exemplo.com
APP_TIMEZONE=America/Sao_Paulo
FRONTEND_URL=https://homolog.exemplo.com
FRONTEND_SCHEME=https
FRONTEND_PORT=
PLATFORM_DOMAINS=homolog.exemplo.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Proxy/Laravel HTTP settings
TRUSTED_PROXIES=*
CORS_ALLOWED_ORIGINS=https://homolog.exemplo.com
CORS_ALLOWED_ORIGIN_PATTERNS=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cursos_homolog
DB_USERNAME=cursos_homolog
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=homolog.exemplo.com
SANCTUM_EXPIRATION=43200

MERCADOPAGO_WEBHOOK_SECRET=CHANGE_ME
MANUAL_WEBHOOK_SECRET=CHANGE_ME

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

# Homologação usa Mailpit; não envie e-mail real.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@homolog.exemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_REGION=sa-east-1

# Variáveis usadas no build do frontend (Docker)
VITE_API_URL=/api/v1
VITE_COMPANY_ID=
VITE_PLATFORM_DOMAINS=homolog.exemplo.com
VITE_MAX_UPLOAD_MB=20

# Optional S3 storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
