APP_NAME="Cursos API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
FRONTEND_URL=http://localhost:5174
FRONTEND_SCHEME=http
FRONTEND_PORT=5174
PLATFORM_DOMAINS=localhost,127.0.0.1

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Proxy/Laravel HTTP settings
TRUSTED_PROXIES=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOWED_ORIGIN_PATTERNS=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cursos_api
DB_USERNAME=cursos
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5174,localhost:8000,127.0.0.1:5174,127.0.0.1:8000

# Sanctum token lifetime in minutes (null = never expires)
SANCTUM_EXPIRATION=

# Payment gateway webhook secrets (required in production)
MERCADOPAGO_WEBHOOK_SECRET=
MANUAL_WEBHOOK_SECRET=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_REGION=sa-east-1

# Optional S3 storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
